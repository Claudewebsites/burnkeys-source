{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "N=\"${CLAUDE_PLUGIN_ROOT}/../node/bin/node\"; [ -x \"$N\" ] || N=node; \"$N\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "N=\"${CLAUDE_PLUGIN_ROOT}/../node/bin/node\"; [ -x \"$N\" ] || N=node; \"$N\" \"${CLAUDE_PLUGIN_ROOT}/hooks/session-check.js\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
